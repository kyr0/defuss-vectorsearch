{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src",
    "scripts/**/*.ts",
    "examples/**/*.ts",
    "vite.config.ts",
    "vitest*.ts"
  ]
}
