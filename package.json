{
  "name": "defuss-vectorsearch",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Isomorphic Harrier and Winzling ONNX vector embeddings with exact and TurboQuant-style vector search.",
  "keywords": [
    "defuss",
    "embeddings",
    "onnx",
    "transformers.js",
    "vector-search",
    "turboquant",
    "browser",
    "node"
  ],
  "author": "Aron Homberg <info@aron-homberg.de>",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/shared.cjs",
  "module": "./dist/shared.mjs",
  "types": "./dist/shared.d.mts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/shared.d.cts",
        "default": "./dist/shared.cjs"
      },
      "import": {
        "types": "./dist/shared.d.mts",
        "default": "./dist/shared.mjs"
      }
    },
    "./client.js": {
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      },
      "import": {
        "types": "./dist/client.d.mts",
        "default": "./dist/client.mjs"
      }
    },
    "./server.js": {
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      },
      "import": {
        "types": "./dist/server.d.mts",
        "default": "./dist/server.mjs"
      }
    },
    "./vector-search.js": {
      "require": {
        "types": "./dist/vector-search.d.cts",
        "default": "./dist/vector-search.cjs"
      },
      "import": {
        "types": "./dist/vector-search.d.mts",
        "default": "./dist/vector-search.mjs"
      }
    },
    "./turboquant.js": {
      "require": {
        "types": "./dist/turboquant.d.cts",
        "default": "./dist/turboquant.cjs"
      },
      "import": {
        "types": "./dist/turboquant.d.mts",
        "default": "./dist/turboquant.mjs"
      }
    },
    "./onnx.js": {
      "require": {
        "types": "./dist/onnx.d.cts",
        "default": "./dist/onnx.cjs"
      },
      "import": {
        "types": "./dist/onnx.d.mts",
        "default": "./dist/onnx.mjs"
      }
    },
    "./browser.js": {
      "import": {
        "types": "./dist/browser.d.mts",
        "default": "./dist/browser.mjs"
      }
    }
  },
  "scripts": {
    "clean": "rm -rf ./dist ./.vitest ./.coverage",
    "prebuild": "bun run clean",
    "build": "pkgroll",
    "test:node": "vitest run --config vitest.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:needle": "vitest run --config vitest.needle.config.ts",
    "test:needle:browser": "vitest run --config vitest.needle.browser.config.ts",
    "test:needle:live": "vitest run --config vitest.needle.live.config.ts",
    "test:live:node": "vitest run --config vitest.live.config.ts",
    "test:live:browser": "vitest run --config vitest.live.browser.config.ts",
    "test:live": "bun run test:live:node && bun run test:live:browser",
    "pretest": "bun run build",
    "test": "bun run test:node && bun run test:browser",
    "prepublishOnly": "bun run test",
    "typecheck": "tsc --noEmit",
    "models:download": "node scripts/download-model.ts",
    "demo": "vite --host 127.0.0.1",
    "test:winzling": "vitest run --config vitest.winzling.config.ts",
    "test:winzling:browser": "vitest run --config vitest.winzling.browser.config.ts",
    "test:demo": "node scripts/test-demo.ts",
    "demo:build": "vite build",
    "test:package": "node scripts/test-package.ts",
    "verify": "make verify"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@huggingface/transformers": "^3.8.1",
    "defuss-db": "^2.0.0",
    "defuss-multicore": "0.1.0",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/browser-playwright": "^4.0.18",
    "@vitest/coverage-v8": "^4.1.11",
    "onnxruntime-node": "1.21.0",
    "oxlint": "^1.87.0",
    "pkgroll": "^2.25.2",
    "playwright": "1.55.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "onnxruntime-node": "1.21.0"
  },
  "peerDependenciesMeta": {
    "onnxruntime-node": {
      "optional": true
    }
  },
  "packageManager": "bun@1.4.2"
}
