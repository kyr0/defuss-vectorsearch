# Optional Hugging Face token, sent only to huggingface.co / hf.co by prefetchModel() in Node.js.
HF_TOKEN=
# Fallback name for the same token.
HF_ACCESS_TOKEN=
# Optional Bun release for scripts/test-bun-consumer.ts, e.g. 1.4.0 (run through `bun x bun@<version>`); empty uses the installed Bun.
BUN_VERSION=
